{"query_id":"r2.7-01-sodium-current-ceiling","query":"What is the current WHO daily sodium and salt ceiling for adults?","lineage_group":"cross-version-sodium-current-ceiling","evidence_items":[{"item_id":"r2.7-01-sodium-current-ceiling::OLD","lineage_group":"cross-version-sodium-current-ceiling","role":"OLD","year":2003,"text":"Limit salt to less than 5 grams per day, equivalent to less than 2 grams sodium.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-01-sodium-current-ceiling::CURRENT","lineage_group":"cross-version-sodium-current-ceiling","role":"CURRENT","year":2012,"text":"The current WHO adult recommendation is 2 grams sodium per day, equivalent to 5 grams salt per day.","source":{"document_id":"who-sodium-2012","official_url":"https://www.who.int/publications/i/item/9789241504836","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/d0f9feb5-ed78-44d1-9e06-533a93352012/content","source_sha256":"1f42c807c29ae255b31554afafaed683d5598414a1e5cc2a4b89190c72e2f369","page_number":9,"chunk_id":"who-sodium-2012-page-9-pass-0-9559b73abf"}}]}
{"query_id":"r2.7-02-potassium-current-food-source","query":"Should most people obtain potassium from foods or from supplements and special products?","lineage_group":"cross-version-potassium-current-food-source","evidence_items":[{"item_id":"r2.7-02-potassium-current-food-source::OLD","lineage_group":"cross-version-potassium-current-food-source","role":"OLD","year":2003,"text":"Meet the potassium goal through adequate daily fruit and vegetable consumption.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":37,"printed_page_number":90}},{"item_id":"r2.7-02-potassium-current-food-source::CURRENT","lineage_group":"cross-version-potassium-current-food-source","role":"CURRENT","year":2012,"text":"Most people can replace potassium losses through food, especially fruits and vegetables, without supplements or special products.","source":{"document_id":"who-potassium-2012","official_url":"https://www.who.int/publications/i/item/9789241504829","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/8516dcd5-49a9-486e-890b-48471468a5bb/content","source_sha256":"c2b221752f81604faf748e1a33420db8bdb8b7eb3b8f33ac8310c712982c4d0d","page_number":13,"chunk_id":"who-potassium-2012-page-13-pass-1-cb5e86171d"}}]}
{"query_id":"r2.7-04-sfa-current-ceiling","query":"What current saturated-fat ceiling does WHO support?","lineage_group":"cross-version-sfa-current-ceiling","evidence_items":[{"item_id":"r2.7-04-sfa-current-ceiling::OLD","lineage_group":"cross-version-sfa-current-ceiling","role":"OLD","year":2003,"text":"Keep saturated fatty acids below 10 percent of total energy.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-04-sfa-current-ceiling::CURRENT","lineage_group":"cross-version-sfa-current-ceiling","role":"CURRENT","year":2023,"text":"Current evidence supports reducing saturated fatty acid intake to 10 percent of total energy and further below 10 percent.","source":{"document_id":"who-sat-trans-fat-2023","official_url":"https://www.who.int/publications/i/item/9789240073630","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/463fa93e-6c17-4e5b-a4d7-928354ea34c3/content","source_sha256":"767c24d20e90357e71831e3e19813f79c84457c8a24ddbca931237a58bd3d503","page_number":46,"chunk_id":"who-sat-trans-fat-2023-page-46-pass-1-02d60d7e53"}}]}
{"query_id":"r2.7-05-tfa-current-ceiling","query":"What current trans-fat ceiling does WHO support?","lineage_group":"cross-version-tfa-current-ceiling","evidence_items":[{"item_id":"r2.7-05-tfa-current-ceiling::OLD","lineage_group":"cross-version-tfa-current-ceiling","role":"OLD","year":2003,"text":"Keep trans fatty acids below 1 percent of total energy.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-05-tfa-current-ceiling::CURRENT","lineage_group":"cross-version-tfa-current-ceiling","role":"CURRENT","year":2023,"text":"Current evidence supports trans-fat intake below 1 percent of total energy.","source":{"document_id":"who-sat-trans-fat-2023","official_url":"https://www.who.int/publications/i/item/9789240073630","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/463fa93e-6c17-4e5b-a4d7-928354ea34c3/content","source_sha256":"767c24d20e90357e71831e3e19813f79c84457c8a24ddbca931237a58bd3d503","page_number":14,"chunk_id":"who-sat-trans-fat-2023-page-14-pass-1-cd7bcb3c6b"}}]}
{"query_id":"r2.7-07-fruit-current-adult-target","query":"What current minimum daily vegetable-and-fruit target applies to adults?","lineage_group":"cross-version-fruit-current-adult-target","evidence_items":[{"item_id":"r2.7-07-fruit-current-adult-target::OLD","lineage_group":"cross-version-fruit-current-adult-target","role":"OLD","year":2003,"text":"Consume at least 400 grams of fruits and vegetables per day.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-07-fruit-current-adult-target::CURRENT","lineage_group":"cross-version-fruit-current-adult-target","role":"CURRENT","year":2023,"text":"WHO selected 400 grams per day as a feasible minimum adult vegetable-and-fruit target.","source":{"document_id":"who-carbohydrate-2023","official_url":"https://www.who.int/publications/i/item/9789240073593","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/6c31b739-c2e8-4515-970d-d9e42346c7f4/content","source_sha256":"81548c804ebf031aa06a71f762c4ed72f680d4cb2caba44b011459fe5c841cd0","page_number":11,"chunk_id":"who-carbohydrate-2023-page-11-pass-2-39d13c25a0"}}]}
{"query_id":"r2.7-08-fibre-current-adult-target","query":"What current minimum naturally occurring dietary-fibre intake applies to adults?","lineage_group":"cross-version-fibre-current-adult-target","evidence_items":[{"item_id":"r2.7-08-fibre-current-adult-target::OLD","lineage_group":"cross-version-fibre-current-adult-target","role":"OLD","year":2003,"text":"Wholegrain foods, fruits, and vegetables can provide more than 25 grams of total dietary fibre per day.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":5,"printed_page_number":58}},{"item_id":"r2.7-08-fibre-current-adult-target::CURRENT","lineage_group":"cross-version-fibre-current-adult-target","role":"CURRENT","year":2023,"text":"Current WHO evidence supports an adult naturally occurring dietary-fibre minimum of 25 grams per day.","source":{"document_id":"who-carbohydrate-2023","official_url":"https://www.who.int/publications/i/item/9789240073593","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/6c31b739-c2e8-4515-970d-d9e42346c7f4/content","source_sha256":"81548c804ebf031aa06a71f762c4ed72f680d4cb2caba44b011459fe5c841cd0","page_number":12,"chunk_id":"who-carbohydrate-2023-page-12-pass-1-a01c1d0ea7"}}]}
{"query_id":"r2.7-09-lsss-current-role","query":"What role do lower-sodium salt substitutes currently have in an overall sodium-reduction strategy?","lineage_group":"cross-version-lsss-current-role","evidence_items":[{"item_id":"r2.7-09-lsss-current-role::OLD","lineage_group":"cross-version-lsss-current-role","role":"OLD","year":2003,"text":"Potassium-enriched lower-sodium salt substitutes are one way to reduce sodium intake.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":37,"printed_page_number":90}},{"item_id":"r2.7-09-lsss-current-role::CURRENT","lineage_group":"cross-version-lsss-current-role","role":"CURRENT","year":2025,"text":"Current guidance treats lower-sodium salt substitutes as only one component of an overall sodium-reduction strategy.","source":{"document_id":"who-lsss-2025","official_url":"https://www.who.int/publications/i/item/9789240105591","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/31fad89a-d7c2-450c-9b74-cd2a8752e60f/content","source_sha256":"e7111969908bbf588c20b457b6f5f26ce16e6d9e023e7e179d8a9c1b54a318a0","page_number":40,"chunk_id":"who-lsss-2025-page-40-pass-1-a909607553"}}]}
{"query_id":"r2.7-11-free-sugar-current-definition","query":"What does the current WHO definition of free sugars include?","lineage_group":"cross-version-free-sugar-current-definition","evidence_items":[{"item_id":"r2.7-11-free-sugar-current-definition::OLD","lineage_group":"cross-version-free-sugar-current-definition","role":"OLD","year":2003,"text":"Free sugars include added monosaccharides and disaccharides plus sugars in honey, syrups, and fruit juices.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-11-free-sugar-current-definition::CURRENT","lineage_group":"cross-version-free-sugar-current-definition","role":"CURRENT","year":2015,"text":"The current definition elaborates free sugars from the 2002 definition, including added sugars and sugars in honey, syrups, fruit juices, and concentrates.","source":{"document_id":"who-sugars-2015","official_url":"https://www.who.int/publications/i/item/9789241549028","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/4be74f01-de93-4596-bbd1-02a97afb1221/content","source_sha256":"0e81d49cffe12469c184a9d377c9ff80fa26f1f08d66b42fed40f1054b67b209","page_number":14,"chunk_id":"who-sugars-2015-page-14-pass-2-b4aa8aee6f"}}]}
{"query_id":"r2.7-13-potassium-target-change","query":"How did the adult potassium target change from the 2003 value to the current recommendation?","lineage_group":"cross-version-potassium-target-change","evidence_items":[{"item_id":"r2.7-13-potassium-target-change::OLD","lineage_group":"cross-version-potassium-target-change","role":"OLD","year":2003,"text":"The 2003 potassium target was 70 to 80 millimoles per day.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":37,"printed_page_number":90}},{"item_id":"r2.7-13-potassium-target-change::CURRENT","lineage_group":"cross-version-potassium-target-change","role":"CURRENT","year":2012,"text":"The current adult potassium target is at least 90 millimoles or 3510 milligrams per day.","source":{"document_id":"who-potassium-2012","official_url":"https://www.who.int/publications/i/item/9789241504829","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/8516dcd5-49a9-486e-890b-48471468a5bb/content","source_sha256":"c2b221752f81604faf748e1a33420db8bdb8b7eb3b8f33ac8310c712982c4d0d","page_number":10,"chunk_id":"who-potassium-2012-page-10-pass-2-dfa70d52a4"}}]}
{"query_id":"r2.7-14-carbohydrate-quantity-quality","query":"What was the 2003 carbohydrate energy range, and which carbohydrate sources does current evidence favour?","lineage_group":"cross-version-carbohydrate-quantity-quality","evidence_items":[{"item_id":"r2.7-14-carbohydrate-quantity-quality::OLD","lineage_group":"cross-version-carbohydrate-quantity-quality","role":"OLD","year":2003,"text":"The 2003 population goal placed total carbohydrate at 55 to 75 percent of energy.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-14-carbohydrate-quantity-quality::CURRENT","lineage_group":"cross-version-carbohydrate-quantity-quality","role":"CURRENT","year":2023,"text":"Current WHO evidence emphasizes carbohydrate quality from whole grains, vegetables, fruits, and pulses.","source":{"document_id":"who-carbohydrate-2023","official_url":"https://www.who.int/publications/i/item/9789240073593","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/6c31b739-c2e8-4515-970d-d9e42346c7f4/content","source_sha256":"81548c804ebf031aa06a71f762c4ed72f680d4cb2caba44b011459fe5c841cd0","page_number":9,"chunk_id":"who-carbohydrate-2023-page-9-pass-2-64610b2651"}}]}
{"query_id":"r2.7-16-sodium-exception-evolution","query":"Which special situations were flagged in 2003, and which clinical exclusions appear in current sodium guidance?","lineage_group":"cross-version-sodium-exception-evolution","evidence_items":[{"item_id":"r2.7-16-sodium-exception-evolution::OLD","lineage_group":"cross-version-sodium-exception-evolution","role":"OLD","year":2003,"text":"The 2003 report flagged pregnancy and non-acclimated strenuous activity in heat as special sodium-reduction situations.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":37,"printed_page_number":90}},{"item_id":"r2.7-16-sodium-exception-evolution::CURRENT","lineage_group":"cross-version-sodium-exception-evolution","role":"CURRENT","year":2012,"text":"Current sodium guidance excludes illnesses and therapies that risk hyponatraemia, water build-up, or require physician-supervised diets.","source":{"document_id":"who-sodium-2012","official_url":"https://www.who.int/publications/i/item/9789241504836","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/d0f9feb5-ed78-44d1-9e06-533a93352012/content","source_sha256":"1f42c807c29ae255b31554afafaed683d5598414a1e5cc2a4b89190c72e2f369","page_number":12,"chunk_id":"who-sodium-2012-page-12-pass-1-14a001784d"}}]}
{"query_id":"r2.7-18-sfa-limit-replacement","query":"What historical saturated-fat ceiling applied, and which current replacement nutrients are preferred?","lineage_group":"cross-version-sfa-limit-replacement","evidence_items":[{"item_id":"r2.7-18-sfa-limit-replacement::OLD","lineage_group":"cross-version-sfa-limit-replacement","role":"OLD","year":2003,"text":"The 2003 population goal kept saturated fatty acids below 10 percent of energy.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-18-sfa-limit-replacement::CURRENT","lineage_group":"cross-version-sfa-limit-replacement","role":"CURRENT","year":2023,"text":"Current guidance evaluates the benefits of replacing saturated fat with polyunsaturated fat, plant monounsaturated fat, or fibre-containing carbohydrates.","source":{"document_id":"who-sat-trans-fat-2023","official_url":"https://www.who.int/publications/i/item/9789240073630","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/463fa93e-6c17-4e5b-a4d7-928354ea34c3/content","source_sha256":"767c24d20e90357e71831e3e19813f79c84457c8a24ddbca931237a58bd3d503","page_number":12,"chunk_id":"who-sat-trans-fat-2023-page-12-pass-1-82fe52d0de"}}]}
{"query_id":"r2.7-19-tfa-limit-child-evidence","query":"What historical trans-fat ceiling applied, and what evidence limitation affects the current child recommendation?","lineage_group":"cross-version-tfa-limit-child-evidence","evidence_items":[{"item_id":"r2.7-19-tfa-limit-child-evidence::OLD","lineage_group":"cross-version-tfa-limit-child-evidence","role":"OLD","year":2003,"text":"The 2003 population goal kept trans fatty acids below 1 percent of energy.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":3,"printed_page_number":56}},{"item_id":"r2.7-19-tfa-limit-child-evidence::CURRENT","lineage_group":"cross-version-tfa-limit-child-evidence","role":"CURRENT","year":2023,"text":"Current trans-fat recommendations for children extrapolate from adult evidence because no relevant child studies were identified.","source":{"document_id":"who-sat-trans-fat-2023","official_url":"https://www.who.int/publications/i/item/9789240073630","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/463fa93e-6c17-4e5b-a4d7-928354ea34c3/content","source_sha256":"767c24d20e90357e71831e3e19813f79c84457c8a24ddbca931237a58bd3d503","page_number":16,"chunk_id":"who-sat-trans-fat-2023-page-16-pass-0-f4a5615de2"}}]}
{"query_id":"r2.7-20-fruit-adult-child-targets","query":"What historical population target applied, and how are current child targets determined?","lineage_group":"cross-version-fruit-adult-child-targets","evidence_items":[{"item_id":"r2.7-20-fruit-adult-child-targets::OLD","lineage_group":"cross-version-fruit-adult-child-targets","role":"OLD","year":2003,"text":"The historical population fruit-and-vegetable target was at least 400 grams per day.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":5,"printed_page_number":58}},{"item_id":"r2.7-20-fruit-adult-child-targets::CURRENT","lineage_group":"cross-version-fruit-adult-child-targets","role":"CURRENT","year":2023,"text":"Current child and adolescent fruit-and-vegetable targets are age-specific values extrapolated from adult evidence.","source":{"document_id":"who-carbohydrate-2023","official_url":"https://www.who.int/publications/i/item/9789240073593","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/6c31b739-c2e8-4515-970d-d9e42346c7f4/content","source_sha256":"81548c804ebf031aa06a71f762c4ed72f680d4cb2caba44b011459fe5c841cd0","page_number":12,"chunk_id":"who-carbohydrate-2023-page-12-pass-0-abf1dcfde4"}}]}
{"query_id":"r2.7-22-lsss-option-kidney-safety","query":"What historical salt-substitution option was proposed, and what current kidney-safety limitation constrains it?","lineage_group":"cross-version-lsss-option-kidney-safety","evidence_items":[{"item_id":"r2.7-22-lsss-option-kidney-safety::OLD","lineage_group":"cross-version-lsss-option-kidney-safety","role":"OLD","year":2003,"text":"The 2003 report identified potassium-enriched lower-sodium salt as a sodium-reduction option.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":37,"printed_page_number":90}},{"item_id":"r2.7-22-lsss-option-kidney-safety::CURRENT","lineage_group":"cross-version-lsss-option-kidney-safety","role":"CURRENT","year":2025,"text":"Current lower-sodium-salt evidence excluded people for whom increased potassium is unsafe, including people with kidney disease.","source":{"document_id":"who-lsss-2025","official_url":"https://www.who.int/publications/i/item/9789240105591","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/31fad89a-d7c2-450c-9b74-cd2a8752e60f/content","source_sha256":"e7111969908bbf588c20b457b6f5f26ce16e6d9e023e7e179d8a9c1b54a318a0","page_number":13,"chunk_id":"who-lsss-2025-page-13-pass-1-7c2ceaf78a"}}]}
{"query_id":"r2.7-24-free-sugar-versus-nss-definition","query":"How do the historical free-sugar definition and the current non-sugar-sweetener definition differ?","lineage_group":"cross-version-free-sugar-versus-nss-definition","evidence_items":[{"item_id":"r2.7-24-free-sugar-versus-nss-definition::OLD","lineage_group":"cross-version-free-sugar-versus-nss-definition","role":"OLD","year":2003,"text":"Free sugars include added monosaccharides and disaccharides plus sugars in honey, fruit juices, and syrups.","source":{"document_id":"who-fao-trs-916-2003-part2","official_pdf_url":"https://www.fao.org/docrep/pdf/005/ac911e/ac911e02.pdf","source_sha256":"f7d8b51b455f4853354b1b86339797da689426f440bc3fa62304eaa4b3d29429","pdf_page_number":56,"printed_page_number":109}},{"item_id":"r2.7-24-free-sugar-versus-nss-definition::CURRENT","lineage_group":"cross-version-free-sugar-versus-nss-definition","role":"CURRENT","year":2023,"text":"Non-sugar sweeteners are synthetic, naturally occurring, or modified non-nutritive sweeteners not classified as sugars.","source":{"document_id":"who-nss-2023","official_url":"https://www.who.int/publications/i/item/9789240073616","official_pdf_url":"https://iris.who.int/server/api/core/bitstreams/e567a191-33a4-44ff-8b37-788a4e432764/content","source_sha256":"eac9098f235dc4b3a6079865aadf9515990d415974f864e8593b6096a6b7d0e3","page_number":13,"chunk_id":"who-nss-2023-page-13-pass-1-74f7dfedc2"}}]}
