# Copy to services/api/.env before `docker compose up`.
# AGENT_API_URL and RUST_LOG are set by compose.yml.

DATABASE_URL=postgres://user:password@host:5432/postgres
DATABASE_URL_2=
JWT_SECRET=change-me
TEST_JWT_TOKEN=

GEMINI_API_KEY=your-google-api-key

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=

CORS_ALLOWED_ORIGINS=

# YOLO inference device: "0" = first GPU, "cpu" = no GPU
YOLO_DEVICE=0

RAG_DOCS_ROOT=/app/uploads
RAG_WORKER_ENABLED=true
RAG_WORKER_POLL_SECONDS=5
RAG_WORKER_BATCH_SIZE=3
RAG_WORKER_MAX_RETRIES=3
RAG_WORKER_RETRY_BASE_SECONDS=30
RAG_WORKER_MAX_BACKOFF_SECONDS=1800
RAG_WORKER_PROCESSING_TIMEOUT_SECONDS=900
RAG_WORKER_STUCK_BATCH_SIZE=20
